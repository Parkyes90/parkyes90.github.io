    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "astro-expressive-code": "^0.44.3",
    "pagefind": "^1.6.0",
    "pretendard": "^1.3.9",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
