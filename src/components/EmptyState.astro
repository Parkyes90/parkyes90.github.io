---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="border-border rounded-xl border border-dashed px-6 py-14 text-center">
  <p class="meta mb-2">∅</p>
  <p class="text-fg font-medium">{title}</p>
  <p class="text-muted mt-1.5 text-sm">
    <slot />
  </p>
</div>
