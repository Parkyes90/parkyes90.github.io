---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { NAV, SITE } from '@/site.config';

const { pathname } = Astro.url;
---

<header class="border-border bg-bg/80 sticky top-0 z-50 border-b backdrop-blur-md">
  <div class="container-page flex h-14 items-center justify-between gap-4">
    <a
      href="/"
      class="text-fg flex items-center gap-2 font-mono text-[0.9375rem] font-semibold tracking-tight"
    >
      <span class="bg-accent size-2 rounded-xs" aria-hidden="true"></span>
      {SITE.title}
    </a>

    <div class="flex items-center gap-1">
      <nav aria-label="주요 메뉴" class="mr-1 flex items-center">
        {NAV.map(({ href, label }) => {
          const active = pathname.startsWith(href);
          return (
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'hover:text-fg rounded-md px-2.5 py-1.5 text-sm transition-colors',
                active ? 'text-fg font-semibold' : 'text-muted',
              ]}
            >
              {label}
            </a>
          );
        })}
      </nav>

      <button
        type="button"
        data-search-open
        aria-label="검색 열기"
        aria-keyshortcuts="Meta+K Control+K"
        class="text-muted hover:text-fg hover:bg-surface flex h-8 items-center gap-2 rounded-md px-2 transition-colors"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <kbd class="border-border hidden rounded border px-1.5 font-mono text-[0.6875rem] leading-5 sm:inline">
          ⌘K
        </kbd>
      </button>

      <ThemeToggle />
    </div>
  </div>
</header>
