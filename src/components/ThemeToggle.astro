---
---

<button
  type="button"
  data-theme-toggle
  aria-label="라이트/다크 테마 전환"
  class="text-muted hover:text-fg hover:bg-surface flex size-8 items-center justify-center rounded-md transition-colors"
>
  <svg
    class="size-4 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
  </svg>
  <svg
    class="hidden size-4 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
</button>

<script>
  // 이벤트 위임이라 페이지 전환 후에도 다시 등록할 필요가 없다.
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('[data-theme-toggle]')) return;
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', next);
    } catch {
      // 저장소를 쓸 수 없는 환경에서는 이번 페이지에서만 바뀐다.
      document.documentElement.dataset.theme = next;
    }
    window.__applyTheme?.();
    document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>
