---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<ul class="border-border border-l text-sm">
  {headings.map((heading) => (
    <li>
      <a
        href={`#${heading.slug}`}
        data-toc-link
        class:list={[
          'text-muted hover:text-fg data-active:border-accent data-active:text-fg -ml-px block border-l border-transparent py-1 leading-snug transition-colors',
          heading.depth === 3 ? 'pl-7' : 'pl-4',
        ]}
      >
        {heading.text}
      </a>
    </li>
  ))}
</ul>
