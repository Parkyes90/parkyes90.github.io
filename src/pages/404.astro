---
import Base from '@/layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없어요" noindex>
  <section class="container-page py-28 text-center sm:py-36">
    <p class="meta">404</p>
    <h1 class="text-fg mt-4 text-3xl font-bold tracking-[-0.03em]">페이지를 찾을 수 없어요</h1>
    <p class="text-muted mt-4 leading-relaxed">주소가 바뀌었거나 지워진 글일 수 있어요.</p>
    <p class="mt-8 flex justify-center gap-6">
      <a href="/" class="link-underline text-fg font-medium">
        홈으로
      </a>
      <a href="/posts/" class="link-underline text-fg font-medium">
        글 목록
      </a>
    </p>
  </section>
</Base>
