---
import PageHeader from '@/components/PageHeader.astro';
import Base from '@/layouts/Base.astro';
import { SITE } from '@/site.config';
---

<Base title="소개" description={`${SITE.author}와 이 블로그에 대한 소개입니다.`}>
  <PageHeader title="소개" />

  <div class="container-page">
    <div class="prose">
      <p>안녕하세요, {SITE.author}입니다.</p>
      <p>
        {SITE.description} 나중에 다시 찾아볼 저 자신을 위한 기록이지만, 비슷한 문제를 만난 분께
        조금이라도 도움이 되면 좋겠습니다.
      </p>
      <h2>연락</h2>
      <ul>
        <li>
          GitHub: <a href={SITE.links.github}>{SITE.links.github.replace('https://', '')}</a>
        </li>
        <li>
          새 글 알림: <a href="/rss.xml">RSS 구독</a>
        </li>
      </ul>
    </div>
  </div>
</Base>
