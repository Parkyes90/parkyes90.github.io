---
import EmptyState from '@/components/EmptyState.astro';
import PostList from '@/components/PostList.astro';
import Base from '@/layouts/Base.astro';
import { getPosts } from '@/lib/posts';
import { SITE } from '@/site.config';

const posts = await getPosts();
const recent = posts.slice(0, SITE.recentPostCount);
---

<Base>
  <section class="container-page pt-16 pb-14 sm:pt-24 sm:pb-20">
    <p class="meta mb-5 flex items-center gap-2">
      <span class="bg-accent size-1.5 rounded-full" aria-hidden="true"></span>
      {new URL(SITE.url).host}
    </p>
    <h1 class="text-fg text-[2rem] leading-[1.25] font-bold tracking-[-0.035em] text-balance sm:text-[2.75rem]">
      {SITE.tagline}
    </h1>
    <p class="text-muted mt-5 max-w-136 text-lg leading-relaxed">{SITE.description}</p>
  </section>

  <section class="container-page" aria-labelledby="recent-posts">
    <div class="border-border flex items-baseline justify-between border-b pb-3">
      <h2 id="recent-posts" class="meta">
        최근 글
      </h2>
      {posts.length > recent.length && (
        <a href="/posts/" class="meta hover:text-accent transition-colors">
          전체 {posts.length}개 →
        </a>
      )}
    </div>
    {recent.length > 0 ? (
      <PostList posts={recent} />
    ) : (
      <div class="pt-8">
        <EmptyState title="아직 올라온 글이 없어요">첫 글을 준비하고 있어요.</EmptyState>
      </div>
    )}
  </section>
</Base>
