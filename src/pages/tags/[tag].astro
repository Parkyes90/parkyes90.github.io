---
import type { GetStaticPaths } from 'astro';
import PageHeader from '@/components/PageHeader.astro';
import PostList from '@/components/PostList.astro';
import Base from '@/layouts/Base.astro';
import { type TagSummary, getPosts, getTags } from '@/lib/posts';

export const getStaticPaths = (async () => {
  const tags = getTags(await getPosts());
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}) satisfies GetStaticPaths;

interface Props {
  tag: TagSummary;
}

const { tag } = Astro.props;
---

<Base title={`#${tag.name}`} description={`'${tag.name}' 태그가 붙은 글 목록입니다.`}>
  <PageHeader title={`#${tag.name}`} eyebrow="태그" count={tag.posts.length} />

  <div class="container-page">
    <div class="border-border border-t">
      <PostList posts={tag.posts} level={2} />
    </div>
    <p class="mt-8">
      <a href="/tags/" class="meta hover:text-accent transition-colors">
        ← 모든 태그
      </a>
    </p>
  </div>
</Base>
