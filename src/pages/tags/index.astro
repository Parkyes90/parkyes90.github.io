---
import EmptyState from '@/components/EmptyState.astro';
import PageHeader from '@/components/PageHeader.astro';
import TagChip from '@/components/TagChip.astro';
import Base from '@/layouts/Base.astro';
import { getPosts, getTags } from '@/lib/posts';

const tags = getTags(await getPosts());
---

<Base title="태그" description="글에 붙인 태그를 모아 둔 목록입니다.">
  <PageHeader title="태그" count={tags.length} />

  <div class="container-page">
    {tags.length > 0 ? (
      <ul class="flex flex-wrap gap-2.5">
        {tags.map((tag) => (
          <li>
            <TagChip name={tag.name} count={tag.posts.length} />
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState title="아직 태그가 없어요">글이 올라오면 태그도 여기에 모여요.</EmptyState>
    )}
  </div>
</Base>
